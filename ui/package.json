{
  "name": "rustryx-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Rustryx web UI (React SPA, built to static files that the rustryx binary embeds)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "mock": "vite --mode mock",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/check-dist.mjs dist production",
    "build:mock": "vite build --mode mock --outDir dist-mock && node scripts/check-dist.mjs dist-mock mock",
    "preview": "vite preview",
    "preview:mock": "vite preview --mode mock --outDir dist-mock --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run lint:contrast && npm run lint:text && npm run lint:code && npm run lint:format",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "lint:code": "eslint .",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "license:check": "node scripts/check-licenses.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:api": "node scripts/gen-api.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run license:check",
    "lint:text": "node scripts/check-dashes.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource/fira-sans": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dismissable-layer": "1.2.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-focus-scope": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-portal": "1.2.0",
    "@radix-ui/react-presence": "1.1.11",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "8.21.3",
    "aria-hidden": "1.2.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.61.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jest-axe": "3.5.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jest-axe": "11.0.0",
    "jsdom": "26.1.0",
    "license-checker-rseidelsohn": "5.0.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "yaml": "2.9.1"
  }
}
