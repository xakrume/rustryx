# Base URL the browser uses for /api/v1 calls. Leave empty for same origin, which is
# what production (the rustryx binary serves the UI and the API) and the dev proxy use.
# Set it only to reach an API on another origin; that origin then has to be listed in
# the server's cors_allowed_origins (see docs/ui-architecture.md).
VITE_API_BASE_URL=

# Dev server only (never read by the production build): backend that `npm run dev`
# proxies /api and /repository to, for example http://localhost:8080.
# Empty means no backend: the dev server falls back to the in-browser mock (MSW).
RUSTRYX_API_URL=
