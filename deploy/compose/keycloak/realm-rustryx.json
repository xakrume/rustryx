  "clients": [
    {
      "clientId": "rustryx-ui",
      "name": "Rustryx UI",
      "description": "Confidential client: authorization code with PKCE S256 only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "rustryx-ui-secret-TEST-ONLY",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "rootUrl": "http://localhost:8081",
      "baseUrl": "http://localhost:8081/",
      "redirectUris": [
        "http://localhost:8081/api/v1/auth/oidc/callback",
        "https://rustryx.localhost/api/v1/auth/oidc/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false",
        "access.token.signed.response.alg": "RS256",
        "post.logout.redirect.uris": "http://localhost:8081/##https://rustryx.localhost/",
        "client_credentials.use_refresh_token": "false",
        "use.refresh.tokens": "true"
      },
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "microprofile-jwt"
      ],
      "protocolMappers": [
        {
          "name": "audience-rustryx-ui",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "rustryx-ui",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "rustryx-cli",
      "name": "Rustryx CLI and CI",
      "description": "Confidential client: client credentials for CI service accounts, device authorization for interactive CLI. Not a public client.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "rustryx-cli-secret-TEST-ONLY",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "oauth2.device.code.lifespan": "600",
        "oauth2.device.polling.interval": "5",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false",
        "access.token.signed.response.alg": "RS256",
        "client_credentials.use_refresh_token": "false",
        "use.refresh.tokens": "false"
      },
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "microprofile-jwt"
      ],
