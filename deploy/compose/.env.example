# Local development and integration-test environment for deploy/compose.
# EVERY VALUE HERE IS A PUBLIC TEST VALUE. Never reuse one outside a developer
# machine. To change something, create deploy/compose/.env (ignored by git);
# its values override these.

# --- PostgreSQL 16 ---------------------------------------------------------
POSTGRES_USER=rustryx
POSTGRES_PASSWORD=rustryx-test-only
POSTGRES_DB=rustryx

# --- Redis 7 ---------------------------------------------------------------
REDIS_PASSWORD=redis-test-only

# --- SeaweedFS (S3) --------------------------------------------------------
S3_ACCESS_KEY=rustryx-seaweed
S3_SECRET_KEY=seaweed-test-only-secret
S3_BUCKET=rustryx-blobs
S3_REGION=us-east-1

# --- Keycloak --------------------------------------------------------------
# Host port of the HTTPS listener. It is part of the issuer
# (https://localhost:<port>/realms/rustryx), so change it only together with
# every client that validates `iss`.
KEYCLOAK_HTTPS_PORT=8443
# Master realm admin, for the admin console and ci/verify-fixtures.sh.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-test-only
# Must equal the secret of client rustryx-ui in keycloak/realm-rustryx.json;
# ci/verify-fixtures.sh fails when they differ. The realm file is shared with the
# integration tests, so its secrets are literals and this file follows it.
RUSTRYX_UI_CLIENT_SECRET=rustryx-ui-secret-TEST-ONLY
RUSTRYX_CLI_CLIENT_SECRET=rustryx-cli-secret-TEST-ONLY

# --- OpenLDAP --------------------------------------------------------------
LDAP_ADMIN_PASSWORD=ldap-admin-test-only
LDAP_SERVICE_PASSWORD=svc-rustryx-test-only

# --- rustryx service (docker compose --profile rustryx up --build) ---------
# Names follow RUSTRYX_<SECTION>_<KEY> (crates/rustryx-config/src/keys.rs).
RUSTRYX_BUILD_VERSION=0.0.0-dev
RUSTRYX_BUILD_REVISION=local
RUSTRYX_BOOTSTRAP_ADMIN_PASSWORD=admin-test-only-0123456789
